try {
    $folder = Split-Path -Parent $env:FLIP_SETUP
    $script = Join-Path $folder 'flip-monitors.cmd'
    if (-not (Test-Path -LiteralPath $script)) {
        throw "flip-monitors.cmd needs to be in the same folder as this file ($folder)."
    }

    $iconPath = Join-Path $folder 'flip-monitors.ico'
    [IO.File]::WriteAllBytes($iconPath, [Convert]::FromBase64String(($iconData -replace '\s', '')))

    $desktop = [Environment]::GetFolderPath('Desktop')
    $shortcut = (New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path $desktop 'Flip Monitors.lnk'))

    # Going through cmd.exe means the shortcut can also be pinned to the taskbar.
    $shortcut.TargetPath = $env:ComSpec
    $shortcut.Arguments = '/c ""' + $script + '""'
    $shortcut.WorkingDirectory = $folder
    $shortcut.IconLocation = "$iconPath,0"
    $shortcut.WindowStyle = 7
    $shortcut.Description = 'Swap the left and right monitors'
    $shortcut.Save()

    Write-Host 'Added "Flip Monitors" to your desktop.'
} catch {
    Write-Host "Could not create the shortcut: $($_.Exception.GetBaseException().Message)"
}
